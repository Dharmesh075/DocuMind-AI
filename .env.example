# DocuMind AI Environment Configuration

# Application
APP_NAME=DocuMind-AI
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=documind_liquid_glass_secret_key_change_in_production_2026

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (SQLite by default for zero-setup, PostgreSQL for production)
DATABASE_URL=sqlite:///./documind.db
# PostgreSQL example: postgresql+psycopg2://postgres:postgres@localhost:5432/documind_db

# File Storage
STORAGE_BACKEND=local
STORAGE_DIR=./storage/documents
# MinIO / S3 config (Optional)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documind-documents
MINIO_SECURE=False

# Celery & Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# LLM Providers
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Processing Thresholds
CONFIDENCE_THRESHOLD_HIGH=0.85
CONFIDENCE_THRESHOLD_LOW=0.60
AUTO_APPROVE_THRESHOLD=0.95
